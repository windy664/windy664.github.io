---
import Redirect from '../../layouts/Redirect.astro';

export async function getStaticPaths() {
  const routes = ['2026', '2026/06', '2026/07', '2026/09', '2026/10', 'page/2', 'page/3', 'page/4', '2026/page/2', '2026/page/3', '2026/page/4', '2026/06/page/2', '2026/06/page/3'];
  return routes.map((legacy) => ({ params: { legacy } }));
}
