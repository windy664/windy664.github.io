---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts, categories, categoryUrl, postUrl } from '../lib/posts';

const posts = await allPosts();
const featured = posts.find((post) => post.id.includes('windyagent-from-framework-to-application')) || posts[0];
const recent = posts.filter((post) => post.id !== featured.id).slice(0, 8);
const mainCategories = categories(posts).slice(0, 5);
---
<BaseLayout current="/">
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow"><span class="eyebrow-line"></span> 一个人的技术记录</span>
      <h1>把做过的事，<br /><em>想明白再写下来。</em></h1>
      <p>关于 Minecraft 服务端、Agent 工程，以及那些做着做着改变了想法的项目。这里保留方案，也保留复盘。</p>
      <div class="hero-actions"><a class="button button-primary" href="/topics/">从专题开始 <span>↗</span></a><a class="button button-secondary" href="/archives/">浏览全部文章 <span>→</span></a></div>
    <div class="hero-stat"><strong>{posts.length}</strong><span>篇文章，仍在继续记录</span></div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-frame">
        <span class="visual-overline">FIELD NOTES / 001—∞</span>
        <svg class="landscape" viewBox="0 0 640 640" preserveAspectRatio="xMidYMid slice" focusable="false">
          <defs>
            <linearGradient id="landscape-sky" x1="0" y1="0" x2="0" y2="1">
              <stop class="sky-top" offset="0%" /><stop class="sky-bottom" offset="100%" />
            </linearGradient>
            <linearGradient id="landscape-water" x1="0" y1="0" x2="0" y2="1">
              <stop class="water-top" offset="0%" /><stop class="water-bottom" offset="100%" />
            </linearGradient>
          </defs>
          <rect width="640" height="640" fill="url(#landscape-sky)" />
          <circle class="sun-halo" cx="420" cy="225" r="118" />
          <circle class="sun" cx="420" cy="225" r="66" />
          <g class="cloud cloud-one"><path d="M-80 148c68-24 121-21 190-5 40 10 83 10 135-2-75 34-167 28-245 24-33-2-59-7-80-17Z" /></g>
          <g class="cloud cloud-two"><path d="M285 116c62-18 130-14 185 3 45 14 89 14 155 0-51 30-112 35-175 27-55-7-113-15-165-30Z" /></g>
          <path class="mountain-back" d="M0 345 86 267l67 64 104-113 92 103 93-85 102 103 96-56v357H0Z" />
          <path class="mountain-mid" d="M0 390 128 292l104 95 93-58 95 80 122-134 98 89v276H0Z" />
          <path class="mountain-front" d="M0 456 105 382l97 48 103-79 122 85 115-59 98 63v200H0Z" />
          <path class="shore" d="M0 474c108-27 200-18 293-1 128 24 237 11 347-21v188H0Z" />
          <path class="water" d="M0 497c137-25 227 12 347 1 111-11 206-34 293-18v160H0Z" fill="url(#landscape-water)" />
          <g class="water-lines">
            <path d="M320 517h171M379 537h99M269 558h195M363 581h148M291 605h114" />
          </g>
          <path class="near-shore" d="M0 582c95-24 178-18 255 8 105 35 202 26 385-28v78H0Z" />
          <g class="grass grass-left"><path d="M42 620c2-46-2-75-11-100m10 99c7-39 18-69 31-91m-29 91c-2-23-13-42-27-55m65 56c-3-34-1-55 8-75" /></g>
          <g class="grass grass-right"><path d="M578 618c0-51 10-84 24-111m-25 111c-3-37-12-61-28-82m30 82c10-26 25-47 44-59m-25 59c1-24-2-44-7-60" /></g>
          <g class="birds"><path d="M133 207q10-9 20 0 10-9 20 0m32-24q8-7 16 0 8-7 16 0" /></g>
        </svg>
        <span class="visual-vertical">观察 · 构建 · 复盘</span>
        <span class="visual-bottom">WINDY'S JOURNAL <span>风景会慢慢变化</span></span>
      </div>
    </div>
  </section>

  <div class="divider shell"><span>近期记录</span><span>2026 / 持续更新</span></div>
  <section class="home-section shell">
    <div class="section-heading"><div><span class="section-index">01 / FEATURED</span><h2>最近在想</h2></div><a href={postUrl(featured)} class="section-more">打开文章 ↗</a></div>
    <PostCard post={featured} featured />
  </section>

  <section class="home-section shell">
    <div class="section-heading"><div><span class="section-index">02 / LATEST</span><h2>最新文章</h2></div><a href="/archives/" class="section-more">全部文章 ↗</a></div>
    <div class="post-grid">{recent.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="home-section shell explore-section">
    <div class="section-heading"><div><span class="section-index">03 / EXPLORE</span><h2>按主题探索</h2></div><a href="/topics/" class="section-more">阅读路线 ↗</a></div>
    <div class="topic-teasers">
      <a href="/topics/#windyagent"><span>01 / LONG RUNNING</span><h3>WindyAgent</h3><p>从功能设计、踩坑，到重新思考 Agent 的边界。</p><b>阅读专题 →</b></a>
      <a href="/topics/#engineering"><span>02 / BUILDING</span><h3>工程与服务端</h3><p>Velocity、JVM、跨服通信和真实环境中的问题。</p><b>阅读专题 →</b></a>
      <a href="/topics/#exploration"><span>03 / EXPLORING</span><h3>其他探索</h3><p>比赛、逆向和项目复盘，记录走过的弯路。</p><b>阅读专题 →</b></a>
    </div>
    <div class="category-strip"><span>或按分类阅读</span>{mainCategories.map((item) => <a href={categoryUrl(item.name)}>{item.name}<small>{item.count}</small></a>)}</div>
  </section>
</BaseLayout>
