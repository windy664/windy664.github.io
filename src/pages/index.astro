---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts, categories, categoryUrl, postUrl } from '../lib/posts';

const posts = await allPosts();
const featured = posts.find((post) => post.id.includes('windyagent-from-framework-to-application')) || posts[0];
const recent = posts.filter((post) => post.id !== featured.id).slice(0, 8);
const mainCategories = categories(posts).slice(0, 5);
---
<BaseLayout current="/">
  <section class="hero shell">
    <div class="hero-copy">
      <span class="eyebrow"><span class="eyebrow-line"></span> Torine · 沿途札记</span>
      <h1>行到水穷处，<br /><em>坐看云起时。</em></h1>
      <div class="hero-source">—— 王维<a href="https://zh.wikisource.org/zh-hans/%E7%B5%82%E5%8D%97%E5%88%A5%E6%A5%AD" target="_blank" rel="noopener noreferrer">《终南别业》↗</a></div>
      <p>有些问题，要动手之后才看得清；有些答案，要走过弯路才写得出。这里留着过程，也留着尚未定论的思考。</p>
      <div class="hero-actions"><a class="button button-primary" href="/topics/">沿专题阅读 <span>↗</span></a><a class="button button-secondary" href="/archives/">翻阅全部文章 <span>→</span></a></div>
    <div class="hero-stat"><strong>{posts.length}</strong><span>篇文章，故事仍在继续</span></div>
    </div>
  </section>

  <div class="divider shell"><span>沿途新记</span><span>还在慢慢写下去</span></div>
  <section class="home-section shell">
    <div class="section-heading"><div><span class="section-index">01 / FEATURED</span><h2>近来所想</h2></div><a href={postUrl(featured)} class="section-more">读这一篇 ↗</a></div>
    <PostCard post={featured} featured />
  </section>

  <section class="home-section shell">
    <div class="section-heading"><div><span class="section-index">02 / LATEST</span><h2>新近写下</h2></div><a href="/archives/" class="section-more">全部文章 ↗</a></div>
    <div class="post-grid">{recent.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="home-section shell explore-section">
    <div class="section-heading"><div><span class="section-index">03 / EXPLORE</span><h2>循着线索走</h2></div><a href="/topics/" class="section-more">阅读路线 ↗</a></div>
    <div class="topic-teasers">
      <a href="/topics/#windyagent"><span>01 / LONG RUNNING</span><h3>WindyAgent</h3><p>记录功能如何生长，也追问 Agent 能力的边界。</p><b>阅读专题 →</b></a>
      <a href="/topics/#engineering"><span>02 / BUILDING</span><h3>工程与服务端</h3><p>顺着 Velocity、JVM 与跨服通信的线索，回到问题发生的现场。</p><b>阅读专题 →</b></a>
      <a href="/topics/#exploration"><span>03 / EXPLORING</span><h3>其他探索</h3><p>比赛、逆向与复盘；有些弯路，也值得留下路标。</p><b>阅读专题 →</b></a>
    </div>
    <div class="category-strip"><span>也可以按分类寻路</span>{mainCategories.map((item) => <a href={categoryUrl(item.name)}>{item.name}<small>{item.count}</small></a>)}</div>
  </section>
</BaseLayout>
