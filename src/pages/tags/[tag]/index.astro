---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { allPosts, tags, termSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPosts();
  return tags(posts).map((tag) => ({ params: { tag: termSlug(tag.name) }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag.name)) } }));
}
const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag.name} · 文章标签`}>
  <section class="page-head shell"><span class="eyebrow"><span class="eyebrow-line"></span> TAG / {tag.count} POSTS</span><h1>#{tag.name}</h1><p>标记了这个标签的文章。</p><div class="page-head-links"><a href="/tags/">← 返回标签</a></div></section>
  <section class="shell page-content"><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section>
</BaseLayout>
