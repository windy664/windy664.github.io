---
import { render } from 'astro:content';
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import { allPostsEn, dateText, excerpt, postUrlEn, readingMinutes } from '../../../../../../lib/posts';

export async function getStaticPaths() {
  const posts = await allPostsEn();
  return posts.map((post, index) => {
    const [, , year, month, day, slug] = postUrlEn(post).split('/');
    return { params: { year, month, day, slug }, props: { post, previous: posts[index + 1], next: posts[index - 1] } };
  });
}
const { post, previous, next } = Astro.props;
const { year, month, day, slug } = Astro.params;
const originalUrl = `/${year}/${month}/${day}/${slug}/`;
const { Content, headings } = await render(post);
const category = post.data.categories[0];
---
<BaseLayout title={post.data.title} description={post.data.description || excerpt(post, 155)} article lang="en">
  <div class="article-shell shell">
    <article class="article">
      <header class="article-header">
        <div class="article-crumbs"><a href="/en/">Posts</a><span>/</span><a href={originalUrl}>中文版 ↗</a></div>
        <h1>{post.data.title}</h1>
        <div class="article-meta"><time datetime={dateText(post)}>{dateText(post)}</time><span>·</span><span>{readingMinutes(post)} min read</span>{category && <><span>·</span><span>{category}</span></>}<span>·</span><a href={originalUrl}>中文原文 ↗</a></div>
      </header>
      <div class="article-body prose" data-pagefind-body><Content /></div>
      {post.data.tags.length > 0 && <div class="article-tags"><span>Tags</span>{post.data.tags.map((tag) => <span>#{tag}</span>)}</div>}
      <div class="article-end"><span>— Fin —</span><p>One post rests; the story continues.</p></div>
      <nav class="post-navigation" aria-label="Adjacent posts"><div>{previous && <a href={postUrlEn(previous)}><small>← Older</small><strong>{previous.data.title}</strong></a>}</div><div>{next && <a href={postUrlEn(next)}><small>Newer →</small><strong>{next.data.title}</strong></a>}</div></nav>
    </article>
    {headings.filter((heading) => heading.depth === 2 || heading.depth === 3).length > 1 && <aside class="toc"><span>Contents</span><nav aria-label="Table of contents">{headings.filter((heading) => heading.depth === 2 || heading.depth === 3).map((heading) => <a class:list={[`depth-${heading.depth}`]} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside>}
  </div>
</BaseLayout>
