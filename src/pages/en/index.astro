---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPostsEn, dateText, postUrlEn } from '../../lib/posts';
const posts = await allPostsEn();
const years = [...new Set(posts.map((post) => dateText(post).slice(0, 4)))];
---
<BaseLayout title="Posts in English" lang="en" current="/en/">
  <section class="page-head shell">
    <span class="eyebrow"><span class="eyebrow-line"></span> ENGLISH / {posts.length} POSTS</span>
    <h1>Posts in English</h1>
    <p>Selected long-form engineering notes, translated with AI assistance and reviewed by the author. The full archive lives on the Chinese site.</p>
    <div class="page-head-links"><a href="/archives/">中文版全部文章 ↗</a><a href="https://github.com/windy664" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
  </section>
  <section class="shell archive-list">
    {years.map((year) => <div class="archive-year"><h2>{year}<span>{posts.filter((post) => dateText(post).startsWith(year)).length} posts</span></h2><div>{posts.filter((post) => dateText(post).startsWith(year)).map((post) => <a class="archive-row" href={postUrlEn(post)}><time datetime={dateText(post)}>{dateText(post).slice(5)}</time><span>{post.data.title}</span><b aria-hidden="true">↗</b></a>)}</div></div>)}
    {posts.length === 0 && <p>Translations are on their way. Check back soon, or read the <a href="/">Chinese edition</a>.</p>}
  </section>
</BaseLayout>
