---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPosts, dateText, postUrl } from '../../lib/posts';
const posts = await allPosts();

// 已知专题的元数据（顺序、标题、副标题、介绍）
const topicMeta = new Map<string, { title: string; subtitle: string; intro: string }>([
  ['reverse', { title: '逆向校园软件', subtitle: '从抓包到插件，把平台一个个啃下来', intro: '点餐、校园卡、学习通、图书馆、教务、智慧树，外加一次小米 BootLoader 的碰壁。每篇都从抓包讲起，到请求伪造、协议还原为止，配套的隐私处理单独收尾。' }],
  ['windyagent', { title: 'WindyAgent', subtitle: '从功能生长，到追问边界', intro: '沿着这些文章，可以看到工具、记忆和护栏如何逐渐成形，也看到关于通用运行时的新疑问。' }],
  ['engineering', { title: '工程与服务端', subtitle: '让系统经得起真实运行', intro: '构建、类加载、跨服通信和线程约束。问题总在系统真正运行时浮现，这里记下它们的来龙去脉。' }],
  ['tinkering', { title: '折腾与复盘', subtitle: '桌面、容器和一次黑客松', intro: '换系统、算容器账、复盘比赛。这些事和写代码一样，动手之前都先想清楚要什么。' }],
]);

// 按 topics 字段自动聚合文章
const byTopic = new Map<string, Set<typeof posts[0]>>();
for (const post of posts) {
  for (const topic of post.data.topics ?? []) {
    if (!byTopic.has(topic)) byTopic.set(topic, new Set());
    byTopic.get(topic)!.add(post);
  }
}

const sortedPosts = (topic: string) =>
  [...(byTopic.get(topic) ?? [])].sort((a, b) => dateText(a).localeCompare(dateText(b)));

// 先输出已知专题，再输出文章中声明但尚未配置元数据的专题
const knownTracks = [...topicMeta.entries()].map(([id, meta]) => ({ id, ...meta, posts: sortedPosts(id) }));
const knownIds = new Set(topicMeta.keys());
const extraTracks = [...byTopic.keys()]
  .filter((id) => !knownIds.has(id))
  .map((id) => ({ id, title: id, subtitle: '', intro: '', posts: sortedPosts(id) }));

const tracks = [...knownTracks, ...extraTracks]
  .filter((t) => t.posts.length > 0)
  .map((t, i) => ({ ...t, number: String(i + 1).padStart(2, '0') }));
---
<BaseLayout title="阅读专题" current="/topics/">
  <section class="page-head shell"><span class="eyebrow"><span class="eyebrow-line"></span> READING PATHS</span><h1>从这里开始读</h1><p>从一篇到下一篇，沿着同一个问题的来路走。这里收着几条有起点、有转折，也仍在继续的阅读路径。</p></section>
  <section class="shell topics-page">{tracks.map((track) => <div class="topic-track" id={track.id}><div class="topic-track__intro"><span class="section-index">{track.number} / READING PATH</span><h2>{track.title}</h2>{track.subtitle && <h3>{track.subtitle}</h3>}{track.intro && <p>{track.intro}</p>}</div><ol>{track.posts.map((post) => <li><a href={postUrl(post)}><span>{dateText(post)}</span><strong>{post.data.title}</strong><b aria-hidden="true">↗</b></a></li>)}</ol></div>)}<p class="topics-footnote">这些是推荐阅读路径；<a href="/archives/">归档页</a>保留全部文章。</p></section>
</BaseLayout>
