---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPosts, dateText, postUrl, termSlug } from '../../lib/posts';
const posts = await allPosts();

// 专题标签：只要文章打了这些标签，就自动聚合成对应专题
const topicTags = ['逆向工程', 'WindyAgent', '工程化', '折腾'];

// 可选：为某些标签提供更可读的大标题、副标题和介绍
const topicMeta = new Map<string, { title: string; subtitle?: string; intro?: string }>([
  ['逆向工程', { title: '逆向校园软件', subtitle: '从抓包到插件，把平台一个个啃下来', intro: '点餐、校园卡、学习通、图书馆、教务、智慧树，外加一次小米 BootLoader 的碰壁。每篇都从抓包讲起，到请求伪造、协议还原为止。' }],
  ['WindyAgent', { title: 'WindyAgent', subtitle: '从功能生长，到追问边界', intro: '沿着这些文章，可以看到工具、记忆和护栏如何逐渐成形，也看到关于通用运行时的新疑问。' }],
  ['工程化', { title: '工程与服务端', subtitle: '让系统经得起真实运行', intro: '构建、类加载、跨服通信和线程约束。问题总在系统真正运行时浮现，这里记下它们的来龙去脉。' }],
  ['折腾', { title: '折腾与复盘', subtitle: '桌面、容器和一次黑客松', intro: '换系统、算容器账、复盘比赛。这些事和写代码一样，动手之前都先想清楚要什么。' }],
]);

const tracks = topicTags.map((tag, i) => {
  const meta = topicMeta.get(tag);
  const trackPosts = posts
    .filter((post) => post.data.tags.includes(tag))
    .sort((a, b) => dateText(a).localeCompare(dateText(b)));
  return {
    id: termSlug(tag),
    number: String(i + 1).padStart(2, '0'),
    title: meta?.title || tag,
    subtitle: meta?.subtitle || '',
    intro: meta?.intro || '',
    posts: trackPosts,
  };
}).filter((t) => t.posts.length > 0);
---
<BaseLayout title="阅读专题" current="/topics/">
  <section class="page-head shell"><span class="eyebrow"><span class="eyebrow-line"></span> READING PATHS</span><h1>从这里开始读</h1><p>专题从标签里长出来：你只要在文章里打上标签，页面就自动把它们聚合成阅读路径。</p></section>
  <section class="shell topics-page">{tracks.map((track) => <div class="topic-track" id={track.id}><div class="topic-track__intro"><span class="section-index">{track.number} / READING PATH</span><h2>{track.title}</h2>{track.subtitle && <h3>{track.subtitle}</h3>}{track.intro && <p>{track.intro}</p>}</div><ol>{track.posts.map((post) => <li><a href={postUrl(post)}><span>{dateText(post)}</span><strong>{post.data.title}</strong><b aria-hidden="true">↗</b></a></li>)}</ol></div>)}<p class="topics-footnote">这些是自动聚合出的阅读路径；<a href="/tags/">标签页</a>和<a href="/archives/">归档页</a>保留全部文章。</p></section>
</BaseLayout>
