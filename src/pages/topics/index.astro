---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allPosts, dateText, postUrl } from '../../lib/posts';
import { topicTracks } from '../../lib/topics';
const posts = await allPosts();

const tracks = topicTracks(posts);
---
<BaseLayout title="阅读专题" current="/topics/">
  <section class="page-head shell"><span class="eyebrow"><span class="eyebrow-line"></span> READING PATHS</span><h1>从这里开始读</h1><p>专题从标签里长出来：你只要在文章里打上标签，页面就自动把它们聚合成阅读路径。</p></section>
  <section class="shell topics-page">{tracks.map((track, i) => <div class="topic-track" id={track.id}><div class="topic-track__intro"><span class="section-index">{String(i + 1).padStart(2, '0')} / READING PATH</span><h2>{track.title}</h2><h3>{track.subtitle}</h3></div><ol>{track.posts.map((post) => <li><a href={postUrl(post)}><span>{dateText(post)}</span><strong>{post.data.title}</strong><b aria-hidden="true">↗</b></a></li>)}</ol></div>)}<p class="topics-footnote">这些是自动聚合出的阅读路径：标签下的文章够多就会长成专题；<a href="/tags/">标签页</a>和<a href="/archives/">归档页</a>保留全部文章。</p></section>
</BaseLayout>
